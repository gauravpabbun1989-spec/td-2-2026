<include>
  <extension name="ticketdepart_telxio_inbound">
    <!-- This Telxio gateway is dedicated to TicketDepart's sole public toll-free number. -->
    <condition field="${sip_gateway}" expression="^telxio$">
      <!-- Internal ring-monitor leg; never expose the internal extension to callers. -->
      <action application="transfer" data="1001 XML default"/>
    </condition>
  </extension>
</include>
