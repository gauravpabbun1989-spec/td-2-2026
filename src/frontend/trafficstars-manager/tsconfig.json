{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ESNext"
    ],
    "types": [
      "./worker-configuration.d.ts"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": false,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "./node-buffer-shim.d.ts",
    "./mcp/worker.ts",
    "./shared/trafficstars-api.ts",
    "./auth/worker.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
