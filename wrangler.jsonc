{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ticketdepart",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-09-26",
  "preview_urls": true,
  "assets": {
    "directory": "./src/frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "404",
    "run_worker_first": true
  }
}
