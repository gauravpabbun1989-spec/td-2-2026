{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ticket-depart2",
  "main": "./src/frontend/src/worker.ts",
  "compatibility_date": "2026-09-21",
  "compatibility_flags": ["assets_navigation_has_no_effect"],
  "routes": [
    {
      "pattern": "ticketdepart.com/*",
      "zone_name": "ticketdepart.com"
    }
  ],
  "assets": {
    "directory": "./src/frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/*/null*",
      "/null*",
      "/%*",
      "/.env*",
      "/*/.env*",
      "/.git*",
      "/*/.git*",
      "/.hg*",
      "/*/.hg*",
      "/.svn*",
      "/*/.svn*",
      "/.ssh*",
      "/*/.ssh*",
      "/.aws*",
      "/*/.aws*",
      "/.dockerenv",
      "/wp-*",
      "/xmlrpc.php",
      "/*.php",
      "/*.sql",
      "/*.pem",
      "/*.key",
      "/api/*",
      "/proc/*",
      "/etc/*",
      "/var/*",
      "/debug/*",
      "/ssl/*"
    ]
  }
}
